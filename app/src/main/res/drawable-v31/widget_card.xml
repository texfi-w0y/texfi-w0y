<?xml version="1.0" encoding="utf-8"?>
<!-- Корпус виджета Hairline на Android 12+: радиус берётся у системы, тот же, по которому
     лаунчер скругляет сам виджет, — линия идёт по контуру и не обрывается в углах. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_line" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
