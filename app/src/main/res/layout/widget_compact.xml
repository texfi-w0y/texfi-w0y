<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет Hairline, компактный: обложка, текст, управление в одну строку (около 4×1). Те же id, что в средней и крупной раскладках. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/widget_cover_description"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cover" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_medium"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/w0y_accent"
                android:textSize="10sp"
                tools:text="ИГРАЕТ" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                tools:text="Название трека" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_muted"
                android:textSize="12sp"
                tools:text="Исполнитель" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_previous"
                android:padding="8dp"
                android:src="@drawable/ic_widget_previous"
                android:tint="@color/widget_text" />

            <ImageButton
                android:id="@+id/widget_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_toggle"
                android:padding="8dp"
                android:src="@drawable/ic_widget_play"
                android:tint="@color/w0y_accent" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_next"
                android:padding="8dp"
                android:src="@drawable/ic_widget_next"
                android:tint="@color/widget_text" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
