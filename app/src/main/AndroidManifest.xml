<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Без этого объявления Android 11+ не покажет нам системный
        эквалайзер, даже если он есть, и приложение честно, но неверно
        сообщило бы «эквалайзера в системе нет».
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Только чтобы отдать скачанное обновление системному установщику; сам по себе ничего не ставит. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- До Android 10 выгрузка в «Музыка/w0y music» пишет обычный файл; с 10-й идёт через MediaStore без разрешений. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Нужно для реверба и системного эквалайзера: без него эффекты молча не создаются. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Автодокачка загрузок: планировщик восстанавливает задание после перезагрузки. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".W0yApplication"
        android:allowBackup="true"
        android:icon="@mipmap/icon_w"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_w"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.W0y.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.W0y.Splash" />
        <!--
            Иконка приложения выбирается в настройках: по алиасу на вариант,
            все ведут на одну MainActivity. Включён ровно один (по умолчанию
            IconW), переключает его AppIconSwitcher. Имена — в AppIcon.alias.
        -->
        <activity-alias
            android:name=".IconW"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/icon_w"
            android:roundIcon="@mipmap/icon_w"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLeaf"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_leaf"
            android:roundIcon="@mipmap/icon_leaf"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBars"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_bars"
            android:roundIcon="@mipmap/icon_bars"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRings"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_rings"
            android:roundIcon="@mipmap/icon_rings"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLeafLine"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_leaf_line"
            android:roundIcon="@mipmap/icon_leaf_line"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!--
            Карточка трека уходит в чужое приложение файлом, а файл из своей
            песочницы можно отдать только через провайдера. Наружу открыт
            ровно кэш — см. res/xml/share_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <service
            android:name=".playback.W0yPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- Кнопки виджета приходят сюда медиа-клавишами: своего
                 контроллера у виджета нет, а сервис разбирает их сам. -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
        <service
            android:name=".playback.W0yDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Планировщик системы будит загрузки, когда появится сеть, даже если
             приложение было выгружено. -->
        <service
            android:name="androidx.media3.exoplayer.scheduler.PlatformScheduler$PlatformSchedulerService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Виджет плеера на домашний экран. updatePeriodMillis=0: система
             его по таймеру не будит, перерисовку заказывает сам плеер при
             смене трека или паузе. -->
        <receiver
            android:name=".widget.W0yWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w0y_widget_info" />
        </receiver>
    </application>
</manifest>
